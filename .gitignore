target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# --- Spring Boot ---
src/main/resources/application-local.properties

# --- Node / NPM ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.cache/

# --- IDE ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Environment & Secrets ---
.env
.env.local
.env.production
.env.*.local

# --- Docker ---
docker-compose.override.yml

# --- Logs ---
logs/
*.log

# --- Tools (portable JDK/Maven) ---
tools/
